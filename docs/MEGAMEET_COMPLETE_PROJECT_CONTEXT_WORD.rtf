\pard\sb200\sa110\keepn\b\fs23\f0 A. Production concept: control plane versus media plane\b0\par
\pard\sa60\par
\pard\sa40\f1\fs15 flowchart TD\par
\pard\sa40\f1\fs15   Browser["MegaMeet web / future mobile"]\par
\pard\sa40\f1\fs15   API["MegaMeet Next.js BFF / future control API"]\par
\pard\sa40\f1\fs15   OIDC["Session identity / OIDC provider"]\par
\pard\sa40\f1\fs15   Policy["Meeting authorization / roles / admission"]\par
\pard\sa40\f1\fs15   DB[("PostgreSQL canonical product data")]\par
\pard\sa40\f1\fs15   LK["LiveKit SFU / signaling / media"]\par
\pard\sa40\f1\fs15   Egress["LiveKit Egress (later)"]\par
\pard\sa40\f1\fs15   CDN["Approved streaming origin + CDN (later)"]\par
\pard\sa40\f1\fs15   Audience["Audience playback (later)"]\par
\pard\sa40\f1\fs15   Interaction["Chat / Q&A / polls (later)"]\par
\pard\sa40\f1\fs15   Browser -->|"Authenticated control requests"| API\par
\pard\sa40\f1\fs15   API --> OIDC\par
\pard\sa40\f1\fs15   API --> Policy\par
\pard\sa40\f1\fs15   Policy --> DB\par
\pard\sa40\f1\fs15   Policy -->|"Server-issued scoped media JWT"| Browser\par
\pard\sa40\f1\fs15   Browser <-->|"WebRTC tracks"| LK\par
\pard\sa40\f1\fs15   API -->|"Room/participant management SDK"| LK\par
\pard\sa40\f1\fs15   LK --> Egress\par
\pard\sa40\f1\fs15   Egress --> CDN\par
\pard\sa40\f1\fs15   CDN --> Audience\par
\pard\sa40\f1\fs15   Browser --> Interaction\par
\pard\sa40\f1\fs15   Audience --> Interaction\par
\pard\sa40\f1\fs15   Interaction --> DB\par
\pard\sa60\par
\pard\ql\sa85\fs19\f0 **Security boundary:** the browser never sees provider secrets. App server checks tenant + meeting + invitation/admission + ban + lobby + capacity + server-derived role before issuing a short-lived media credential. Provider room state does not replace MegaMeet's canonical authorization model.\par
\pard\sa60\par
\pard\sb200\sa110\keepn\b\fs23\f0 B. Secure participant join sequence\b0\par
\pard\sa60\par
\pard\sa40\f1\fs15 sequenceDiagram\par
\pard\sa40\f1\fs15   participant U as Browser\par
\pard\sa40\f1\fs15   participant A as MegaMeet app/API\par
\pard\sa40\f1\fs15   participant D as Product DB / policy\par
\pard\sa40\f1\fs15   participant L as LiveKit\par
\pard\sa40\f1\fs15   U->>A: Request join (session or guest invite)\par
\pard\sa40\f1\fs15   A->>D: Verify session / tenant / meeting / ticket / lobby\par
\pard\sa40\f1\fs15   alt Access denied or not admitted\par
\pard\sa40\f1\fs15     D-->>A: Denied / pending\par
\pard\sa40\f1\fs15     A-->>U: 401 / 403 / waiting state\par
\pard\sa40\f1\fs15   else Authorized\par
\pard\sa40\f1\fs15     D-->>A: Internal participant ID + server-derived role\par
\pard\sa40\f1\fs15     A->>A: Mint short-lived room-specific grants\par
\pard\sa40\f1\fs15     A-->>U: No-store URL + scoped JWT\par
\pard\sa40\f1\fs15     U->>L: Connect using server-issued token\par
\pard\sa40\f1\fs15     L-->>U: Media and participant tracks\par
\pard\sa40\f1\fs15   end\par
\pard\sa60\par
\pard\ql\sa85\fs19\f0 **Do not accept browser-provided host roles, raw room identities, arbitrary privileges or recording starts.** Do not put tokens in query strings or logs. Build rejoin/revocation semantics and audit events.\par
\pard\sa60\par
